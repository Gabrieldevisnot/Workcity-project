generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model candidaturas {
  id               Int       @id @default(autoincrement())
  vaga_id          Int?
  profissional_id  Int?
  data_candidatura DateTime? @default(now()) @db.Timestamp(6)
  status           String?   @default("pendente") @db.VarChar(20)
  users            users?    @relation(fields: [profissional_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  vagas            vagas?    @relation(fields: [vaga_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([vaga_id, profissional_id])
}

model convites {
  id                                    Int       @id @default(autoincrement())
  empresa_id                            Int?
  profissional_id                       Int?
  vaga_id                               Int?
  mensagem                              String?
  status                                String?   @default("enviado") @db.VarChar(20)
  created_at                            DateTime? @default(now()) @db.Timestamp(6)
  users_convites_empresa_idTousers      users?    @relation("convites_empresa_idTousers", fields: [empresa_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users_convites_profissional_idTousers users?    @relation("convites_profissional_idTousers", fields: [profissional_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  vagas                                 vagas?    @relation(fields: [vaga_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([vaga_id, profissional_id])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
enum UserType {
  empresa
  profissional
}
model users {
  id                                       Int            @id @default(autoincrement())
  email                                    String         @unique @db.VarChar(255)
  password_hash                            String         @db.VarChar(255)
  user_type                                UserType       
  name                                     String         @db.VarChar(255)
  phone                                    String?        @db.VarChar(50)
  city                                     String?        @db.VarChar(100)
  state                                    String?        @db.VarChar(2)
  address                                  String?
  cnpj                                     String?        @db.VarChar(20)
  cpf                                      String?        @db.VarChar(20)
  specialty                                String?        @db.VarChar(100)
  experience_years                         Int?
  bio                                      String?  
  avatar_url                               String?  
  created_at                               DateTime?      @default(now()) @db.Timestamp(6)
  candidaturas                             candidaturas[]
  convites_convites_empresa_idTousers      convites[]     @relation("convites_empresa_idTousers")
  convites_convites_profissional_idTousers convites[]     @relation("convites_profissional_idTousers")
  vagas                                    vagas[]
}

model vagas {
  id                 Int            @id @default(autoincrement())
  user_id            Int?
  titulo             String         @db.VarChar(255)
  especialidade      String?        @db.VarChar(100)
  localizacao        String?        @db.VarChar(255)
  descricao          String?
  salario_min        Decimal?       @db.Decimal(10, 2)
  salario_max        Decimal?       @db.Decimal(10, 2)
  tipo_contrato      String?        @db.VarChar(50)
  experiencia_minima String?        @db.VarChar(100)
  requisitos         String?
  beneficios         String?
  status             String?        @default("aberta") @db.VarChar(20)
  created_at         DateTime?      @default(now()) @db.Timestamp(6)
  candidaturas       candidaturas[]
  convites           convites[]
  users              users?         @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}
