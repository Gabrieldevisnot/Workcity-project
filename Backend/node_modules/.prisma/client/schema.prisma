generator client {
  provider      = "prisma-client-js"
  // Garante compatibilidade com Docker (Linux) e Windows
  binaryTargets = ["native", "debian-openssl-1.1.x", "debian-openssl-3.0.x", "linux-musl", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Enum para garantir os tipos corretos
enum UserType {
  empresa
  profissional
}

model users {
  id               Int       @id @default(autoincrement())
  email            String    @unique
  password_hash    String
  user_type        UserType
  name             String
  phone            String?
  city             String?
  state            String?
  address          String?
  cnpj             String?
  cpf              String?
  specialty        String?
  experience_years Int?
  bio              String?
  avatar_url       String?
  created_at       DateTime? @default(now())

  // RELACIONAMENTOS (Nomes importantes para o código funcionar)
  vagas              vagas[]
  candidaturas       candidaturas[]
  
  // Convites
  convites_enviados  convites[]     @relation("EmpresaConvite")
  convites_recebidos convites[]     @relation("ProfissionalConvite")
  
  // Chat
  messages_sent      messages[]     @relation("Sender")
  messages_received  messages[]     @relation("Receiver")
}

model vagas {
  id                 Int            @id @default(autoincrement())
  user_id            Int?
  titulo             String         @db.VarChar(255)
  especialidade      String?        @db.VarChar(100)
  localizacao        String?        @db.VarChar(255)
  descricao          String?
  salario_min        Decimal?       @db.Decimal(10, 2)
  salario_max        Decimal?       @db.Decimal(10, 2)
  tipo_contrato      String?        @db.VarChar(50)
  experiencia_minima String?        @db.VarChar(100)
  requisitos         String?
  beneficios         String?
  status             String?        @default("aberta") @db.VarChar(20)
  created_at         DateTime?      @default(now())
  
  users              users?         @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  candidaturas       candidaturas[]
  convites           convites[]
}

model candidaturas {
  id               Int       @id @default(autoincrement())
  vaga_id          Int?
  profissional_id  Int?
  status           String?   @default("pendente") @db.VarChar(20)
  data_candidatura DateTime? @default(now())
  
  users            users?    @relation(fields: [profissional_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  vagas            vagas?    @relation(fields: [vaga_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([vaga_id, profissional_id])
}

model convites {
  id              Int       @id @default(autoincrement())
  empresa_id      Int
  profissional_id Int
  vaga_id         Int
  mensagem        String?
  status          String?   @default("enviado") @db.VarChar(20)
  created_at      DateTime? @default(now())

  // Relacionamentos Nomeados
  empresa         users     @relation("EmpresaConvite", fields: [empresa_id], references: [id])
  profissional    users     @relation("ProfissionalConvite", fields: [profissional_id], references: [id])
  vagas           vagas     @relation(fields: [vaga_id], references: [id])

  @@unique([vaga_id, profissional_id])
}

model messages {
  id          Int      @id @default(autoincrement())
  content     String
  sender_id   Int
  receiver_id Int
  created_at  DateTime @default(now())

  sender      users    @relation("Sender", fields: [sender_id], references: [id])
  receiver    users    @relation("Receiver", fields: [receiver_id], references: [id])
}